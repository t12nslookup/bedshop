= form_with model: shop, class: 'card card-body shadow-sm gap-3' do |form|
  - if shop.errors.any?
    .alert.alert-danger{ role: 'alert' }
      %h2.h6
        = pluralize(shop.errors.count, 'error')
        prohibited this shop from being saved:
      %ul
        - shop.errors.each do |error|
          %li= error.full_message
  .mb-1
    = form.label :shop, 'Shop name', class: 'form-label'
    = form.text_field :shop, class: 'form-control', placeholder: 'e.g. Dream Sleep', required: true, autofocus: true
  = form.submit class: 'btn btn-primary align-self-start'
