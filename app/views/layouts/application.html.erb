<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Bedshop — a tiny shop and mattress demo" %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.9/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-yEPZ7jP9S0QKiUQ0m3jjsO4ProIW7wvR9gXkI7JOGa2XVsw53Yke2bsdkBbjmmiX"
      crossorigin="anonymous">
    <%= stylesheet_link_tag 'application', media: 'all' %>
  </head>

  <body class="d-flex min-vh-100 flex-column bg-body-tertiary">
    <header>
      <nav class="navbar navbar-expand bg-dark navbar-dark">
        <div class="container">
          <%= link_to "Bedshop", root_path, class: "navbar-brand fw-semibold" %>
          <div class="navbar-nav flex-row gap-3">
            <%= link_to "Shops", shops_path, class: "nav-link" %>
            <%= link_to "Mattresses", mattresses_path, class: "nav-link" %>
          </div>
        </div>
      </nav>
    </header>

    <main class="container flex-grow-1 py-5">
      <% flash.each do |type, message| %>
        <% alert_class = type.to_s == "notice" ? "success" : "danger" %>
        <div class="alert alert-<%= alert_class %>" role="alert">
          <%= message %>
        </div>
      <% end %>

      <%= yield %>
    </main>

    <footer class="border-top bg-white py-4">
      <div class="container d-flex flex-column flex-sm-row justify-content-between gap-2 small text-body-secondary">
        <span>Bedshop · a tiny Rails demo</span>
        <span>Two tables, one simple association.</span>
      </div>
    </footer>
  </body>
</html>
