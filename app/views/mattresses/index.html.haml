- content_for :title, 'Mattresses · Bedshop'

.d-flex.flex-column.flex-md-row.justify-content-between.align-items-md-end.gap-3.mb-4
  .page-heading
    %p.text-uppercase.small.fw-semibold.text-primary.mb-2 The catalog
    %h1.display-6.fw-bold.mb-2 Mattresses
    %p.text-body-secondary.mb-0 Each mattress belongs to one shop. Keep the relationship simple and easy to explore.
  = link_to 'Add a mattress', new_mattress_path, class: 'btn btn-primary'

.d-flex.align-items-center.justify-content-between.mb-3
  %h2.h5.fw-semibold.mb-0 All mattresses
  %span.badge.text-bg-light.border= pluralize(@mattresses.size, 'mattress')

- if @mattresses.any?
  .table-responsive.bg-white.rounded-3.shadow-sm
    %table.table.table-hover.mb-0
      %thead.table-light
        %tr
          %th{ scope: 'col' } Mattress
          %th{ scope: 'col' } Shop
          %th{ scope: 'col' } Actions
      %tbody
        - @mattresses.each do |mattress|
          %tr
            %td= link_to "Mattress ##{mattress.id}", mattress, class: 'fw-semibold text-decoration-none'
            %td= link_to mattress.shop.shop, mattress.shop, class: 'text-decoration-none'
            %td
              .d-flex.flex-wrap.gap-2
                = link_to 'Edit', edit_mattress_path(mattress), class: 'btn btn-sm btn-outline-secondary'
                = button_to 'Delete', mattress, method: :delete, class: 'btn btn-sm btn-outline-danger'
- else
  .empty-state.p-5.text-center
    %h2.h5.fw-semibold No mattresses yet
    %p.text-body-secondary Create a shop first, then add a mattress to it.
    = link_to 'Add a mattress', new_mattress_path, class: 'btn btn-primary'
