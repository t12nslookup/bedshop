= form_with model: mattress, class: 'card card-body shadow-sm gap-3' do |form|
  - if mattress.errors.any?
    .alert.alert-danger{ role: 'alert' }
      %h2.h6
        = pluralize(mattress.errors.count, 'error')
        prohibited this mattress from being saved:
      %ul
        - mattress.errors.each do |error|
          %li= error.full_message
  .mb-1
    = form.label :shop_id, 'Shop', class: 'form-label'
    = form.collection_select :shop_id, shops, :shop_id, :shop, { include_blank: 'Choose a shop' }, { class: 'form-select', required: true }
  = form.submit class: 'btn btn-primary align-self-start'
